---
layout: null
permalink: /search.json
---
[
{% assign articles = site.articles | sort: 'date' | reverse %}
{% assign faculty = site.faculty | sort: 'full_name' %}
{% for a in articles %}
  {% comment %} "Accounting, Policy": the main topic first, then any "Also relates to" topics, so a search for either finds it. {% endcomment %}
  {% capture sj_slug_list %}{% include topic-links.html article=a slugs=true %}{% endcapture %}
  {% assign sj_slugs = sj_slug_list | split: ',' %}
  {% capture sj_topics %}{% for sj_slug in sj_slugs %}{% assign sj_t = site.data.topics | where: 'slug', sj_slug | first %}{% unless forloop.first %}, {% endunless %}{{ sj_t.name }}{% endfor %}{% endcapture %}
  {
    "type": "Article",
    "title": {{ a.title | jsonify }},
    "dek": {{ a.dek | jsonify }},
    "url": {{ a.url | relative_url | jsonify }},
    "topic": {{ sj_topics | jsonify }},
    "byline": {{ a.byline | jsonify }}
  }{% unless forloop.last and faculty.size == 0 %},{% endunless %}
{% endfor %}
{% for f in faculty %}
  {
    "type": "Faculty",
    "title": {{ f.full_name | jsonify }},
    "dek": {{ f.title | jsonify }},
    "url": {{ f.url | relative_url | jsonify }},
    "topic": "Faculty",
    "byline": ""
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
