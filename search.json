---
layout: null
permalink: /search.json
---
[
{% assign articles = site.articles | sort: 'date' | reverse %}
{% assign media = site.media | sort: 'date' | reverse %}
{% assign faculty = site.faculty | sort: 'full_name' %}
{% for a in articles %}
  {% assign topic_data = site.data.topics | where: 'slug', a.topic | first %}
  {
    "type": "Article",
    "title": {{ a.title | jsonify }},
    "dek": {{ a.dek | jsonify }},
    "url": {{ a.url | relative_url | jsonify }},
    "topic": {{ topic_data.name | jsonify }},
    "byline": {{ a.byline | jsonify }}
  }{% unless forloop.last and media.size == 0 and faculty.size == 0 %},{% endunless %}
{% endfor %}
{% for m in media %}
  {% assign topic_data = site.data.topics | where: 'slug', m.topic | first %}
  {
    "type": "Video",
    "title": {{ m.title | jsonify }},
    "dek": {{ m.dek | jsonify }},
    "url": {{ m.url | relative_url | jsonify }},
    "topic": {{ topic_data.name | default: "Video" | jsonify }},
    "byline": "Ideate Video"
  }{% unless forloop.last and faculty.size == 0 %},{% endunless %}
{% endfor %}
{% for f in faculty %}
  {
    "type": "Faculty",
    "title": {{ f.full_name | jsonify }},
    "dek": {{ f.title | jsonify }},
    "url": {{ f.url | relative_url | jsonify }},
    "topic": "Faculty",
    "byline": ""
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
